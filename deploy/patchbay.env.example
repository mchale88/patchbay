# Patchbay configuration (loaded by systemd EnvironmentFile)

# Web UI / API listen address
HOST=0.0.0.0
PORT=8080

# Authentication: on first start, open the web UI and create the admin account.
# Users and API keys are then managed in the web UI (Settings). They are stored
# hashed in auth.json next to the state file (override with AUTH_FILE).
# Recovery from a shell:  <prefix>/venv/bin/python -m patchbay user passwd <name>
# SESSION_DAYS=30                    # web UI login lifetime

# Path to libndi.so.6 (file or directory). Defaults to $NDI_RUNTIME_DIR_V6 and system paths.
NDI_LIB_PATH=

# Optional NDI settings
# NDI_GROUPS=public            # groups to discover in and publish outputs to
# NDI_EXTRA_IPS=10.0.1.20,10.0.2.0   # unicast discovery for sources on other subnets
# NDI_DISCOVERY_SERVER=10.0.0.5      # use an NDI Discovery Server instead of mDNS
# OUTPUT_PREFIX=RTR-                 # prefix for output stream names

LOG_LEVEL=info
